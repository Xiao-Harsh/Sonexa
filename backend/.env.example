# Database configuration (TiDB Cloud in production / MySQL locally)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=music_player
DB_USER=root
DB_PASS=
# Set to true for TiDB Cloud / any SSL-required MySQL host
DB_USE_SSL=false

# Redis configuration (Upstash in production / local Redis in dev)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASS=
# Set to true for Upstash Redis (TLS required)
REDIS_SSL_ENABLED=false

# JWT config (Generate a secure 256-bit key in production)
JWT_SECRET=5367566B59703373367639792F423F4528482B4D6251655468576D5A71347437

# Audius API client identification
AUDIUS_APP_NAME=MyWebMusicPlayer

# CORS: comma-separated list of allowed frontend origins (no trailing slash)
# Example for production: CORS_ALLOWED_ORIGINS=https://sonexa.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
